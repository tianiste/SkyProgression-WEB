---
/**
 * The site's main call to action: download the mod (SITE.download). Text and a pixel download arrow. "compact" is
 * the header version.
 */
import { SITE } from "../config";

interface Props {
  size?: "large" | "compact";
  label?: string;
}

const { size = "large", label = "Download the mod" } = Astro.props;
---

<a class:list={["dl", size]} href={SITE.download}>
  <svg width="16" height="16" viewBox="0 0 8 8" aria-hidden="true" shape-rendering="crispEdges">
    <path fill="currentColor" d="M3 0h2v3h2v1h-1v1h-1v1h-2v-1h-1v-1h-1v-1h2zM0 6h1v1h6v-1h1v2h-8z"></path>
  </svg>
  <span>{label}</span>
</a>

<style>
  /* A filled diamond-coloured button with a hard pixel shadow that drops away when pressed. */
  .dl {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0.6rem 1.15rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--accent-ink);
    background: var(--accent);
    border-radius: var(--radius);
    box-shadow: 0 4px 0 var(--accent-deep);
    text-decoration: none;
    white-space: nowrap;
  }
  .dl:hover {
    background: var(--accent-hover);
  }
  .dl:active {
    transform: translateY(2px);
    box-shadow: 0 2px 0 var(--accent-deep);
  }
  .dl:focus-visible {
    outline: 3px solid var(--text);
    outline-offset: 3px;
  }
  .large {
    font-size: var(--step-1);
    padding: 0.75rem 1.4rem;
    min-height: 3.25rem;
  }
  .large svg {
    width: 20px;
    height: 20px;
  }
  @media (max-width: 480px) {
    .large {
      font-size: var(--step-0);
      padding: 0.7rem 1.1rem;
      white-space: normal;
    }
  }
  .compact {
    font-size: var(--step--1);
    padding: 0.5rem 0.85rem;
    box-shadow: 0 3px 0 var(--accent-deep);
  }
</style>
