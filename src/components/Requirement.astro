---
/**
 * One guide requirement as a to-do item: the empty square (filled in later by player lookup), the item's icon and name,
 * then its upgrades as icon chips. Every icon has its text next to it.
 */
import type { LeafRequirement, Requirement } from "../schema/guide";
import { modifiersOf, modifierText, title } from "../lib/requirements";
import { itemIcon, modifierIcon, requirementIcon, type Icon as IconT } from "../lib/icons";
import { itemName } from "../data/items";
import Icon from "./Icon.astro";

interface Props {
  r: Requirement | LeafRequirement;
  attributeNames?: Map<string, string>;
  rarityOf?: (attribute: string) => string | undefined;
  showTier?: boolean;
}

const { r, attributeNames, rarityOf, showTier = false } = Astro.props;
const mods = modifiersOf(r);
const chips: { icon: IconT; text: string }[] = mods
  .filter((m) => m.kind !== "enchant" && m.kind !== "note")
  .map((m) => ({ icon: modifierIcon(m), text: modifierText(m) }));
if (r.kind === "pet" && r.pet.item) chips.push({ icon: itemIcon(r.pet.item), text: itemName(r.pet.item) });
const enchants = mods.filter((m) => m.kind === "enchant").map(modifierText);
const notes = mods.filter((m) => m.kind === "note").map(modifierText);
const options = r.kind === "any_of" ? r.options : [];
---

<li class="req" data-requirement={r.id}>
  <span class="box" aria-hidden="true"></span>
  <span class="slot"><Icon icon={requirementIcon(r, rarityOf)} size={32} class="main" /></span>
  <div class="body">
    <span class="name">{title(r, attributeNames)}</span>
    {r.priority === "optional" && <span class="tag">optional</span>}
    {showTier && r.tier && <span class={`tag ${r.tier}`}>{r.tier}</span>}
    {
      options.length > 0 && (
        <ul class="chips options" aria-label="Any one of">
          {options.map((o) => (
            <li class="chip">
              <Icon icon={requirementIcon(o, rarityOf)} size={16} />
              {title(o, attributeNames)}
            </li>
          ))}
        </ul>
      )
    }
    {
      chips.length > 0 && (
        <ul class="chips" aria-label="Upgrades">
          {chips.map((c) => (
            <li class="chip">
              <Icon icon={c.icon} size={16} />
              {c.text}
            </li>
          ))}
        </ul>
      )
    }
    {
      enchants.length > 0 && (
        <p class="enchants">
          <Icon icon={{ kind: "glyph", glyph: "book", color: "var(--stat-purple)" }} size={16} />
          <span><span class="visually-hidden">Enchantments: </span>{enchants.join(", ")}</span>
        </p>
      )
    }
    {notes.length > 0 && <p class="note">{notes.join(". ")}</p>}
    {r.note && <p class="note">{r.note}</p>}
  </div>
</li>

<style>
  .req {
    display: grid;
    grid-template-columns: 1rem 40px minmax(0, 1fr);
    align-items: start;
    gap: 0.75rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--line);
    max-width: none;
  }
  @media (max-width: 480px) {
    .req {
      gap: 0.5rem;
    }
  }
  .req:first-child {
    border-top: 0;
  }
  .box {
    width: 1rem;
    height: 1rem;
    margin-top: 0.75rem;
    border: 2px solid var(--muted);
  }
  .body {
    padding-top: 0.45rem;
  }
  .name {
    font-weight: 600;
    margin-right: 0.4rem;
  }
  .tag {
    margin-right: 0.3rem;
    vertical-align: 0.1em;
  }
  .chips {
    list-style: none;
    margin: 0.4rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.15rem 0.45rem 0.15rem 0.3rem;
    font-size: 0.8125rem;
    line-height: 1.3;
    background: var(--surface-2);
    border-radius: 2px;
    max-width: 100%;
  }
  .options .chip {
    background: transparent;
    border: 1px dashed var(--line);
  }
  .enchants {
    display: flex;
    gap: 0.35rem;
    align-items: flex-start;
    margin: 0.4rem 0 0;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .enchants :global(.icon) {
    margin-top: 1px;
  }
  .note {
    margin: 0.35rem 0 0;
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
