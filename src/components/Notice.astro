---
import { formatDate } from "../lib/format";

/** A dated note that a guide or its source is outdated, or that a game change made part of it stale. */
interface Props {
  status: "outdated" | "stale";
  date: Date;
  text: string;
  source?: { label: string; url: string } | undefined;
}
const { status, date, text, source } = Astro.props;
---

<p class="notice" role="note">
  <strong>{status === "outdated" ? "Outdated." : "Partly out of date."}</strong> {text}
  <span class="when">
    Noted {formatDate(date)}{source && <>; source: <a href={source.url} rel="noopener">{source.label}</a></>}.
  </span>
</p>

<style>
  .notice {
    margin: 0.75rem 0 0;
    padding: 0.6rem 0.8rem;
    border-left: 3px solid var(--gold);
    background: var(--surface-2);
    color: var(--text);
    max-width: none;
  }
  .notice strong {
    color: var(--gold);
  }
  .when {
    color: var(--muted);
    font-size: var(--step--1);
  }
</style>
