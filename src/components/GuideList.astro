---
/** Guides grouped by category, each category marked with the colour of its material. */
import { getCollection } from "astro:content";
import { CATEGORIES } from "../lib/categories";
import { categoryIcon, guideIcon } from "../lib/icons";
import Icon from "./Icon.astro";

interface Props {
  headingLevel?: 2 | 3;
  showSummary?: boolean;
}

const { headingLevel = 2, showSummary = true } = Astro.props;
const H = `h${headingLevel}` as "h2" | "h3";
const guides = (await getCollection("guides")).sort((a, b) => a.data.title.localeCompare(b.data.title));
const groups = CATEGORIES.map((c) => ({ ...c, guides: guides.filter((g) => g.data.category === c.id) })).filter((c) => c.guides.length);
---

<div class="categories">
  {
    groups.map((c) => (
      <section class="category" id={c.id} data-category={c.id} aria-labelledby={`cat-${c.id}`}>
        <H id={`cat-${c.id}`} class="cat-title">
          <span class="slot"><Icon icon={categoryIcon(c.id)} size={32} /></span>
          {c.label}
          <span class="count">{c.guides.length} {c.guides.length === 1 ? "guide" : "guides"}</span>
        </H>
        <ul>
          {c.guides.map((g) => (
            <li>
              <span class="slot"><Icon icon={guideIcon(g.id)} size={32} /></span>
              <div>
                <a href={`/guides/${g.id}/`}>{g.data.title}</a>
                {showSummary && <span class="summary">{g.data.summary}</span>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  .categories {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr));
    align-items: start;
    gap: 1rem;
    margin-top: 1rem;
  }
  /* Each category is a panel; its rows are the guides, each with its icon in a slot. */
  .category {
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.25rem 1rem 0.5rem;
  }
  .cat-title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-pixel);
    font-weight: 600;
    font-size: clamp(var(--step-1), 1rem + 1vw, var(--step-2));
    margin: 0.75rem 0 0.5rem;
  }
  .count {
    margin-left: auto;
    white-space: nowrap;
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--muted);
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0;
    border-top: 1px solid var(--line);
    max-width: none;
  }
  li:has(.summary) {
    align-items: flex-start;
  }
  li:has(.summary) > div {
    padding-top: 0.1rem;
  }
  li a {
    font-weight: 600;
  }
  .summary {
    display: block;
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.5;
    margin-top: 0.1rem;
  }
</style>
