---
/**
 * A Heart of the Mountain tree drawn from data with the FurfSky Reborn HOTM pieces: 7 columns x 10 tiers, tier 10 at
 * the top, each perk drawn with the piece for its position and state. Each perk is a button that opens a popover with
 * its name and level (mouse, keyboard and touch, no script); the same information is listed as text below.
 */
import { PERKS, tierOf, type Perk } from "../data/perks";
import { hotmPiece } from "../lib/icons";

interface Props {
  id: string;
  perks: Partial<Record<string, "max" | number>>;
  ability?: string;
  disabled?: string[];
  /** Abilities unlocked next to the selected one. */
  unlocked?: string[];
  label: string;
}

const { id, perks, ability, disabled = [], unlocked = [], label } = Astro.props;

type State = "max" | "bridge" | "level" | "none" | "selected" | "standby" | "ability" | "disabled" | "core";

function stateOf(p: Perk): State {
  if (p.kind === "core") return "core";
  if (p.kind === "ability") return p.id === ability ? "selected" : unlocked.includes(p.id) ? "standby" : "ability";
  if (disabled.includes(p.id)) return "disabled";
  const v = perks[p.id];
  if (v === undefined) return "none";
  if (v === "max" || v >= p.max) return "max";
  return v === 1 ? "bridge" : "level";
}

const STATE_TEXT: Record<State, string> = {
  max: "Maxed",
  bridge: "Unlocked only to reach other perks",
  level: "Partly levelled",
  none: "Not taken",
  selected: "Selected ability",
  standby: "Ability unlocked, not selected",
  ability: "Ability, not selected",
  disabled: "Unlocked but turned off",
  core: "Core of the Mountain",
};

const WORDS = ["locked", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten"];
const coreLevel = typeof perks.core_of_the_mountain === "number" ? perks.core_of_the_mountain : perks.core_of_the_mountain === "max" ? 10 : 0;

/** FurfSky piece states to try, best first. */
const PIECE: Record<State, string> = {
  max: "maxed",
  bridge: "unlocked|maxed",
  level: "unlocked|maxed",
  none: "locked",
  selected: "maxed|unlocked",
  standby: "unlocked|locked",
  ability: "locked",
  disabled: "disabled",
  core: WORDS[coreLevel] ?? "locked",
};

function levelText(p: Perk, s: State): string {
  const v = perks[p.id];
  if (s === "max") return `${p.max} / ${p.max}`;
  if (s === "level" && typeof v === "number") return `${v} / ${p.max}`;
  if (s === "bridge") return `low level, max ${p.max}`;
  if (s === "none") return `max ${p.max}`;
  if (s === "core") return coreLevel > 1 ? `level ${coreLevel} / 10` : "level not shown in the picture";
  return "";
}

const cells = PERKS.map((p) => ({ perk: p, state: stateOf(p), src: hotmPiece(p.id, PIECE[stateOf(p)]) }));
const groups: State[] = ["selected", "standby", "max", "level", "bridge", "disabled"];
const used = new Set(cells.map((c) => c.state));
const legend: { state: State; perk: string; text: string }[] = [
  { state: "max", perk: "strong_arm", text: "Maxed" },
  { state: "bridge", perk: "strong_arm", text: "Unlocked to reach others" },
  { state: "none", perk: "strong_arm", text: "Not taken" },
  ...(used.has("disabled") ? [{ state: "disabled" as State, perk: "strong_arm", text: "Unlocked, turned off" }] : []),
  { state: "selected", perk: "mining_speed_boost", text: "Selected ability (lit)" },
  ...(used.has("standby") ? [{ state: "standby" as State, perk: "mining_speed_boost", text: "Ability unlocked, not selected (green ring)" }] : []),
  { state: "ability", perk: "mining_speed_boost", text: "Other ability (dark)" },
];
---

<figure class="hotm" aria-label={label}>
  <div class="grid" role="group" aria-label={`${label}, perk grid`}>
    {
      cells.map(({ perk, state, src }) => {
        const pid = `${id}-${perk.id}`;
        const text = `${STATE_TEXT[state]}${levelText(perk, state) ? `, ${levelText(perk, state)}` : ""}`;
        return (
          <>
            <button
              class={`cell ${state}${src ? " piece" : ""}`}
              style={`grid-column:${perk.x + 1};grid-row:${perk.y + 1}`}
              popovertarget={pid}
              aria-label={`${perk.name}: ${text}`}
              title={perk.name}
            >
              {src ? <img class="pixelated" src={src} width="32" height="32" alt="" loading="lazy" decoding="async" /> : <span class="glyph" aria-hidden="true" />}
            </button>
            <div id={pid} popover class="tip">
              <strong>{perk.name}</strong>
              <span>{`Tier ${tierOf(perk)}. ${text}.`}</span>
            </div>
          </>
        );
      })
    }
  </div>
  <figcaption>
    <ul class="legend">
      {
        legend.map((l) => (
          <li>
            <span class={`swatch-box ${l.state}`}>
              {hotmPiece(l.perk, PIECE[l.state]) ? (
                <img class="pixelated" src={hotmPiece(l.perk, PIECE[l.state])} width="32" height="32" alt="" />
              ) : (
                <span class={`cell ${l.state}`} aria-hidden="true"><span class="glyph" /></span>
              )}
            </span>
            {l.text}
          </li>
        ))
      }
    </ul>
    <p class="muted">Round tiles are the FurfSky Reborn HOTM icons for abilities, Core of the Mountain and key perks.</p>
    <details class="perk-list">
      <summary>Perks as a list</summary>
      <dl>
        {
          groups.map((g) => {
            const list = cells.filter((c) => c.state === g);
            return list.length ? (
              <>
                <dt>{STATE_TEXT[g]}</dt>
                <dd>{list.map((c) => c.perk.name).join(", ")}</dd>
              </>
            ) : null;
          })
        }
        <dt>Core of the Mountain</dt>
        <dd>{coreLevel > 1 ? `Level ${coreLevel}` : "Level not shown in the picture"}</dd>
      </dl>
    </details>
  </figcaption>
</figure>

<style>
  .hotm {
    margin: 1rem 0 1.5rem;
    max-width: 24rem;
  }
  /* The pieces are drawn for a dark menu, so the panel stays dark in both themes. */
  .grid {
    display: grid;
    grid-template-columns: repeat(7, 32px);
    grid-template-rows: repeat(10, 32px);
    width: max-content;
    padding: 12px;
    background: #1c1e26;
    border: 2px solid #3a3e4c;
    border-radius: var(--radius);
  }
  .cell {
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
    display: block;
  }
  .cell img {
    display: block;
  }
  .cell:hover {
    background: rgb(255 255 255 / 0.12);
  }
  .cell:focus-visible {
    outline: 2px solid #4fe3ec;
    outline-offset: -2px;
  }
  /* Ordinary perks: a square whose colour and shape both show the state. */
  .cell:not(.piece) {
    margin: 4px;
    width: 24px;
    height: 24px;
    display: grid;
    place-items: center;
    border: 2px solid #3a3e4c;
    background: #2b2f3c;
  }
  .glyph {
    display: block;
    width: 50%;
    height: 50%;
  }
  .cell.max:not(.piece) {
    background: #4fe3ec;
    border-color: #4fe3ec;
  }
  .cell.max .glyph {
    background: #1c1e26;
    clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%);
  }
  .cell.bridge:not(.piece),
  .cell.level:not(.piece) {
    border-color: #8ef04a;
  }
  .cell.bridge .glyph {
    width: 30%;
    height: 30%;
    background: #8ef04a;
  }
  .cell.level .glyph {
    width: 60%;
    height: 60%;
    background: #8ef04a;
  }
  .cell.none:not(.piece) {
    border-style: dashed;
    background: transparent;
  }
  /* A selected ability without a lit piece (Pickobulus, Tunnel Vision, Sheer Force): a lit tile with a round mark. */
  .cell.selected:not(.piece) {
    background: #4fe3ec;
    border-color: #4fe3ec;
  }
  .cell.selected .glyph {
    background: #1c1e26;
    border-radius: 50%;
  }
  /* An unlocked ability that is not selected: the dark piece with a green ring. */
  .cell.standby,
  .swatch-box.standby {
    box-shadow: inset 0 0 0 2px #8ef04a;
  }
  .cell.disabled:not(.piece) {
    border-color: #d4524a;
  }
  .cell.disabled .glyph {
    background: linear-gradient(45deg, transparent 42%, #d4524a 42% 58%, transparent 58%);
  }
  .tip {
    margin: auto;
    max-width: min(20rem, calc(100vw - 32px));
    padding: 0.75rem 1rem;
    background: var(--surface);
    color: var(--text);
    border: 2px solid var(--accent);
    border-radius: var(--radius);
    font-size: var(--step--1);
  }
  .tip strong {
    display: block;
    font-size: var(--step-0);
  }
  .tip::backdrop {
    background: rgb(0 0 0 / 0.35);
  }
  figcaption {
    margin-top: 0.75rem;
    font-size: var(--step--1);
  }
  figcaption p {
    margin: 0 0 0.5rem;
  }
  .legend {
    list-style: none;
    padding: 0;
    margin: 0 0 0.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: 0.25rem 1rem;
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .swatch-box {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: none;
    background: #1c1e26;
    border-radius: 2px;
  }
  .swatch-box .cell {
    cursor: default;
  }
  .perk-list summary {
    cursor: pointer;
    color: var(--accent);
  }
  .perk-list dt {
    font-weight: 650;
    margin-top: 0.5rem;
  }
  .perk-list dd {
    margin: 0;
    color: var(--muted);
  }
</style>
