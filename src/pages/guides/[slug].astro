---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Requirement from "../../components/Requirement.astro";
import HotmTree from "../../components/HotmTree.astro";
import Credit from "../../components/Credit.astro";
import Icon from "../../components/Icon.astro";
import { groupIcon, guideIcon, shardIcon } from "../../lib/icons";
import { CATEGORIES } from "../../lib/categories";
import { GEAR_GROUPS, GROUP_LABELS } from "../../lib/requirements";
import { formatDate, formatPowder } from "../../lib/format";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((g) => ({ params: { slug: g.id }, props: { guide: g } }));
}

const { guide } = Astro.props;
const g = guide.data;
const { Content, headings } = await render(guide);
const category = CATEGORIES.find((c) => c.id === g.category)!;

const attributes = await getCollection("attributes");
const attrById = new Map(attributes.map((a) => [a.id, a.data]));
const attributeNames = new Map(attributes.map((a) => [a.id, a.data.name]));
const rarityOf = (id: string) => attrById.get(id)?.rarity;

const reqs = g.requirements;
const gear = GEAR_GROUPS.map((id) => {
  const list = reqs.filter((r) => r.group === id);
  return {
    id,
    label: GROUP_LABELS[id],
    budget: list.filter((r) => r.tier === "budget"),
    max: list.filter((r) => r.tier === "max"),
    both: list.filter((r) => !r.tier),
  };
}).filter((s) => s.budget.length + s.max.length + s.both.length > 0);
const attributeReqs = reqs.filter((r) => r.kind === "attribute");
const hotmReqs = reqs.filter((r) => r.group === "hotm");
const PRIORITY = { required: "Required", recommended: "Recommended", optional: "Useful" } as const;

const treeIds = [...new Set(g.hotm.map((h) => h.tree).filter(Boolean))] as string[];
const trees = (await Promise.all(treeIds.map((id) => getEntry("trees", id)))).filter((t) => t !== undefined);
const hasPowder = (k: "mithril" | "gemstone" | "glacite") => g.hotm.some((h) => h.powder[k] !== undefined);

const toc = [
  { id: "glance", label: "At a glance" },
  { id: "gear", label: "Gear" },
  g.hotm.length || hotmReqs.length ? { id: "hotm", label: "Heart of the Mountain" } : null,
  attributeReqs.length ? { id: "attributes", label: "Attributes" } : null,
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, label: h.text })),
  g.videos.length ? { id: "videos", label: "Videos" } : null,
  { id: "credits", label: "Credits and sources" },
].filter((t) => t !== null);
---

<Base title={`${g.title} guide`} description={g.summary}>
  <div class="layout">
    <article>
      <header class="guide-head">
        <p class="crumbs"><a href="/guides/">Guides</a> / <a href={`/guides/#${category.id}`}>{category.label}</a></p>
        <h1 class="title"><Icon icon={guideIcon(guide.id)} size={64} />{g.title}</h1>
        <p class="lead">{g.summary}</p>
        <p class="byline">
          {
            g.authors.some((a) => a.id !== "mining-cult") ? (
              <>Guide by {g.authors.map((a, i) => <>{i > 0 && " and "}<Credit id={a.id} /></>)}, posted in the <Credit id="mining-cult" /></>
            ) : (
              <>Posted in the <Credit id="mining-cult" /> without a named author</>
            )
          }{g.source.posted && <> on {formatDate(g.source.posted)}</>}. Checked {formatDate(g.updated)}.
        </p>
      </header>

      <section class="progress" aria-labelledby="progress-title">
        <div class="xp" aria-hidden="true"><span></span></div>
        <p id="progress-title">
          <strong>0 of {reqs.length} checked.</strong>{" "}
          <span class="muted">Player lookup will tick off what you already have. Coming soon.</span>
        </p>
      </section>

      <section id="glance" aria-labelledby="glance-title">
        <h2 id="glance-title" class="visually-hidden">At a glance</h2>
        <dl class="glance">
          <div>
            <dt>Where</dt>
            <dd>{g.where}</dd>
          </div>
          {
            g.blocks.length > 0 && (
              <div>
                <dt>Key blocks</dt>
                <dd>
                  <ul>{g.blocks.map((b) => <li>{b}</li>)}</ul>
                </dd>
              </div>
            )
          }
          {
            (g.rates.length > 0 || g.ratesMeasured) && (
              <div>
                <dt>Rates</dt>
                <dd>
                  {g.rates.length > 0 && <ul class="rates">
                    {g.rates.map((r) => (
                      <li>
                        <span class="rate-label">{r.label}</span> <span class="rate-value">{r.value}</span>
                        {r.note && <span class="muted small"> {r.note}</span>}
                      </li>
                    ))}
                  </ul>}
                  {g.ratesMeasured && <p class="muted small">{g.ratesMeasured}</p>}
                </dd>
              </div>
            )
          }
        </dl>
      </section>

      <section id="gear" aria-labelledby="gear-title">
        <h2 id="gear-title">Gear</h2>
        <p class="muted">
          <span class="tag budget">budget</span> is the cheapest setup the guide recommends, <span class="tag max">max</span> the
          best one. Everything else applies to both.
        </p>
        {
          gear.map((s) => (
            <section class="gear-group" aria-labelledby={`g-${s.id}`}>
              <h3 id={`g-${s.id}`} class="with-icon"><Icon icon={groupIcon(s.id)} size={32} />{s.label}</h3>
              {(s.budget.length > 0 || s.max.length > 0) && (
                <div class="tiers">
                  <div class="tier">
                    <h4><span class="tag budget">budget</span></h4>
                    {s.budget.length ? (
                      <ul class="reqs">{s.budget.map((r) => <Requirement r={r} attributeNames={attributeNames} rarityOf={rarityOf} />)}</ul>
                    ) : (
                      <p class="muted small">Nothing extra for this tier.</p>
                    )}
                  </div>
                  <div class="tier">
                    <h4><span class="tag max">max</span></h4>
                    {s.max.length ? (
                      <ul class="reqs">{s.max.map((r) => <Requirement r={r} attributeNames={attributeNames} rarityOf={rarityOf} />)}</ul>
                    ) : (
                      <p class="muted small">Same as budget.</p>
                    )}
                  </div>
                </div>
              )}
              {s.both.length > 0 && <ul class="reqs">{s.both.map((r) => <Requirement r={r} attributeNames={attributeNames} rarityOf={rarityOf} />)}</ul>}
            </section>
          ))
        }
      </section>

      {
        (g.hotm.length > 0 || hotmReqs.length > 0) && (
          <section id="hotm" aria-labelledby="hotm-title">
            <h2 id="hotm-title">Heart of the Mountain</h2>
            {g.hotm.length > 0 && (
              <table class="table">
                <thead>
                  <tr>
                    <th scope="col">Preset</th>
                    <th scope="col" class="num">HOTM</th>
                    <th scope="col" class="num">Tokens</th>
                    {hasPowder("mithril") && <th scope="col" class="num">Mithril</th>}
                    {hasPowder("gemstone") && <th scope="col" class="num">Gemstone</th>}
                    {hasPowder("glacite") && <th scope="col" class="num">Glacite</th>}
                  </tr>
                </thead>
                <tbody>
                  {g.hotm.map((h) => (
                    <tr>
                      <td data-label="Preset">
                        <strong>{h.label}</strong>
                        {h.note && <span class="muted"> {h.note}</span>}
                      </td>
                      <td class="num" data-label="HOTM">{h.hotm}</td>
                      <td class="num" data-label="Tokens">{h.tokens ?? "–"}</td>
                      {hasPowder("mithril") && <td class="num" data-label="Mithril">{formatPowder(h.powder.mithril)}</td>}
                      {hasPowder("gemstone") && <td class="num" data-label="Gemstone">{formatPowder(h.powder.gemstone)}</td>}
                      {hasPowder("glacite") && <td class="num" data-label="Glacite">{formatPowder(h.powder.glacite)}</td>}
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
            {trees.map((t) => (
              <>
                <h3>{t.data.title} tree</h3>
                <p class="muted small">
                  Picture by {t.data.author && <Credit id={t.data.author.id} />}. {t.data.note}
                </p>
                <HotmTree id={t.id} label={`${t.data.title} HOTM tree`} perks={t.data.perks} ability={t.data.ability} disabled={t.data.disabled} />
              </>
            ))}
            {trees.length === 0 && (
              <p class="muted">
                The drawn tree for this method is coming soon. The <a href="/hotm/">HOTM trees page</a> lists the ones that are ready.
              </p>
            )}
            {hotmReqs.length > 0 && (
              <>
                <h3>Key perks</h3>
                <ul class="reqs">{hotmReqs.map((r) => <Requirement r={r} attributeNames={attributeNames} rarityOf={rarityOf} showTier />)}</ul>
              </>
            )}
          </section>
        )
      }

      {
        attributeReqs.length > 0 && (
          <section id="attributes" aria-labelledby="attributes-title">
            <h2 id="attributes-title">Attributes</h2>
            <p class="muted">
              Level 10 values. See the <a href="/reference/attributes/">attribute reference</a> for every mining attribute.
            </p>
            <table class="table">
              <thead>
                <tr>
                  <th scope="col">Attribute</th>
                  <th scope="col">Shard</th>
                  <th scope="col">Effect</th>
                  <th scope="col">Priority</th>
                </tr>
              </thead>
              <tbody>
                {attributeReqs.map((r) => {
                  const a = r.kind === "attribute" ? attrById.get(r.attribute) : undefined;
                  return (
                    <tr data-requirement={r.id}>
                      <td data-label="Attribute" class="attr"><Icon icon={shardIcon(a?.rarity)} size={16} /><strong>{a?.name ?? (r.kind === "attribute" ? r.attribute : r.id)}</strong></td>
                      <td data-label="Shard">{a ? `${a.shard} (${a.rarity})` : "–"}</td>
                      <td data-label="Effect">{a?.effect}{r.note && <span class="muted"> {r.note}</span>}</td>
                      <td data-label="Priority">{r.priority ? PRIORITY[r.priority] : "–"}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </section>
        )
      }

      <div class="prose">
        <Content />
      </div>

      {
        g.videos.length > 0 && (
          <section id="videos" aria-labelledby="videos-title">
            <h2 id="videos-title">Videos</h2>
            <ul>
              {g.videos.map((v) => (
                <li>
                  <a href={v.url}>{v.title}</a>
                  {v.by && <span class="muted"> by {v.by}</span>}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section id="credits" aria-labelledby="credits-title">
        <h2 id="credits-title">Credits and sources</h2>
        <ul>
          {g.authors.map((a) => <li>{a.role ?? "Guide"}: <Credit id={a.id} all /></li>)}
          {g.contributors.map((a) => <li>{a.role ?? "Contributor"}: <Credit id={a.id} all /></li>)}
          <li>
            Source: {g.source.name}{g.source.posted && <>, posted {formatDate(g.source.posted)}</>}. Last checked {formatDate(g.updated)}.
          </li>
          <li>
            Requirements as data: <a href={`/guides/${guide.id}.json`}>{guide.id}.json</a> (format: <a href="/schema/guide.json">guide schema</a>).
          </li>
        </ul>
        <p class="muted small">Found a mistake? Tell the author in the Mining Cult Discord, or open an issue on <a href="https://github.com/tianiste/SkyProgression-WEB/issues">GitHub</a>.</p>
      </section>
    </article>

    <aside class="toc" aria-label="On this page">
      <p class="toc-title">On this page</p>
      <ul>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ul>
    </aside>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }
  @media (min-width: 1000px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 13rem;
    }
    .toc {
      position: sticky;
      top: 1.5rem;
      align-self: start;
    }
  }
  @media (max-width: 999px) {
    .toc {
      display: none;
    }
  }
  .toc-title {
    font-weight: 650;
    margin-bottom: 0.5rem;
  }
  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--step--1);
    border-left: 2px solid var(--line);
  }
  .toc li a {
    display: block;
    padding: 0.25rem 0 0.25rem 0.75rem;
    color: var(--muted);
    text-decoration: none;
  }
  .toc li a:hover {
    color: var(--accent);
  }
  .title {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .with-icon {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .attr {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  @media (max-width: 640px) {
    .attr {
      display: block;
    }
  }
  .crumbs {
    font-size: var(--step--1);
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .byline {
    font-size: var(--step--1);
    color: var(--muted);
  }
  .progress {
    display: grid;
    gap: 0.5rem;
    margin: 1.5rem 0 2rem;
    padding: 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .progress p {
    margin: 0;
    font-size: var(--step--1);
  }
  /* The XP bar from the logo: a deep green track that fills with bright green. */
  .xp {
    height: 12px;
    background: var(--surface-2);
    border: 2px solid var(--line);
  }
  .xp span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--xp);
    box-shadow: inset 0 -3px 0 var(--xp-deep);
  }
  .glance {
    display: grid;
    gap: 1rem;
    margin: 0;
  }
  .glance > div {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
  }
  @media (max-width: 560px) {
    .glance > div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
  .glance dt {
    color: var(--muted);
  }
  .glance dd {
    margin: 0;
  }
  .glance ul {
    margin: 0;
    padding-left: 1.1rem;
  }
  .rate-label {
    color: var(--muted);
  }
  .rate-value {
    font-weight: 400;
  }
  .tiers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 0 2rem;
  }
  .tier h4 {
    margin: 0.5rem 0 0;
  }
  .reqs {
    list-style: none;
    padding: 0;
    margin: 0 0 0.5rem;
  }
  .gear-group + .gear-group {
    border-top: 1px solid var(--line);
  }
  .prose :global(h2) {
    scroll-margin-top: 1rem;
  }
  .prose :global(ul) {
    padding-left: 1.25rem;
  }
</style>
