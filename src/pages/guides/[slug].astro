---
import { getCollection, getEntry, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Requirement from "../../components/Requirement.astro";
import HotmTree from "../../components/HotmTree.astro";
import Credit from "../../components/Credit.astro";
import Icon from "../../components/Icon.astro";
import { categoryIcon, groupIcon, guideIcon, powderIcon, shardIcon, type Icon as IconT } from "../../lib/icons";
import { CATEGORIES } from "../../lib/categories";
import { GEAR_GROUPS, GROUP_LABELS } from "../../lib/requirements";
import { formatDate, formatPowder } from "../../lib/format";

export async function getStaticPaths() {
  const guides = await getCollection("guides");
  return guides.map((g) => ({ params: { slug: g.id }, props: { guide: g } }));
}

const { guide } = Astro.props;
const g = guide.data;
const { Content, headings } = await render(guide);
const category = CATEGORIES.find((c) => c.id === g.category)!;

const attributes = await getCollection("attributes");
const attrById = new Map(attributes.map((a) => [a.id, a.data]));
const attributeNames = new Map(attributes.map((a) => [a.id, a.data.name]));
const rarityOf = (id: string) => attrById.get(id)?.rarity;

const reqs = g.requirements;
const gear = GEAR_GROUPS.map((id) => {
  const list = reqs.filter((r) => r.group === id);
  return {
    id,
    label: GROUP_LABELS[id],
    budget: list.filter((r) => r.tier === "budget"),
    max: list.filter((r) => r.tier === "max"),
    both: list.filter((r) => !r.tier),
  };
}).filter((s) => s.budget.length + s.max.length + s.both.length > 0);
const attributeReqs = reqs.filter((r) => r.kind === "attribute");
const hotmReqs = reqs.filter((r) => r.group === "hotm");
const PRIORITY = { required: "Required", recommended: "Recommended", optional: "Useful" } as const;

const treeIds = [...new Set(g.hotm.map((h) => h.tree).filter(Boolean))] as string[];
const trees = (await Promise.all(treeIds.map((id) => getEntry("trees", id)))).filter((t) => t !== undefined);

const note: IconT = { kind: "glyph", glyph: "note" };
const toc: { id: string; label: string; icon: IconT }[] = [
  { id: "glance", label: "At a glance", icon: { kind: "glyph", glyph: "pin", color: "var(--accent)" } },
  g.hotm.length || hotmReqs.length ? { id: "hotm", label: "Heart of the Mountain", icon: powderIcon("mithril") } : null,
  { id: "gear", label: "Gear", icon: groupIcon("drill") },
  attributeReqs.length ? { id: "attributes", label: "Attributes", icon: shardIcon("Epic") } : null,
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, label: h.text, icon: note })),
  g.videos.length ? { id: "videos", label: "Videos", icon: note } : null,
  { id: "credits", label: "Credits and sources", icon: { kind: "glyph", glyph: "book", color: "var(--stat-purple)" } },
].filter((t) => t !== null);
const tierCount = (n: number) => `${n} ${n === 1 ? "item" : "items"}`;
---

<Base title={`${g.title} guide`} description={g.summary}>
  <div class="layout">
    <article>
      <header class="guide-head">
        <p class="crumbs"><a href="/guides/">Guides</a> / <a href={`/guides/#${category.id}`}>{category.label}</a></p>
        <div class="head-row">
          <span class="slot lg"><Icon icon={guideIcon(guide.id)} size={64} /></span>
          <h1 class="title">{g.title}</h1>
          <p class="lead">{g.summary}</p>
        </div>
        <p class="byline">
          {
            g.authors.some((a) => a.id !== "mining-cult") ? (
              <>Guide by {g.authors.map((a, i) => <>{i > 0 && " and "}<Credit id={a.id} /></>)}, posted in the <Credit id="mining-cult" /></>
            ) : (
              <>Posted in the <Credit id="mining-cult" /> without a named author</>
            )
          }{g.source.posted && <> on {formatDate(g.source.posted)}</>}. Checked {formatDate(g.updated)}.
        </p>
      </header>
      <div class="seam" aria-hidden="true"></div>

      <section class="progress" aria-labelledby="progress-title">
        <div class="xp" aria-hidden="true"><span></span></div>
        <p id="progress-title">
          <strong>0 of {reqs.length} checked.</strong>{" "}
          <span class="muted">Player lookup will tick off what you already have. Coming soon.</span>
        </p>
      </section>

      <details class="toc-mobile">
        <summary>On this page</summary>
        <ul>{toc.map((t) => <li><a href={`#${t.id}`}><Icon icon={t.icon} size={16} />{t.label}</a></li>)}</ul>
      </details>

      <section id="glance" aria-labelledby="glance-title">
        <h2 id="glance-title" class="visually-hidden">At a glance</h2>
        <dl class="glance">
          <div class="where">
            <dt><Icon icon={{ kind: "glyph", glyph: "pin", color: "var(--accent)" }} size={16} />Where</dt>
            <dd>{g.where}</dd>
          </div>
          {
            g.blocks.length > 0 && (
              <div class="blocks">
                <dt><Icon icon={categoryIcon(g.category)} size={16} />Key blocks</dt>
                <dd>
                  <ul>{g.blocks.map((b) => <li>{b}</li>)}</ul>
                </dd>
              </div>
            )
          }
          {
            (g.rates.length > 0 || g.ratesMeasured) && (
              <div class="rates-box">
                <dt><Icon icon={{ kind: "glyph", glyph: "coin" }} size={16} />Rates</dt>
                <dd>
                  {g.rates.length > 0 && <ul class="rates">
                    {g.rates.map((r) => (
                      <li>
                        <span class="rate-label">{r.label}</span> <strong class="rate-value">{r.value}</strong>
                        {r.note && <span class="muted small"> {r.note}</span>}
                      </li>
                    ))}
                  </ul>}
                  {g.ratesMeasured && <p class="muted small">{g.ratesMeasured}</p>}
                </dd>
              </div>
            )
          }
        </dl>
      </section>

      <div class="gear-hotm">
        {
          (g.hotm.length > 0 || hotmReqs.length > 0) && (
            <section id="hotm" class="hotm-col" aria-labelledby="hotm-title">
              <h2 id="hotm-title">Heart of the Mountain</h2>
              {g.hotm.map((h) => (
                <div class="preset">
                  <p class="preset-name">
                    <strong>{h.label}</strong>
                    <span class="muted small">
                      {" "}HOTM {h.hotm}{h.tokens && <>, {h.tokens} tokens</>}{h.cotm !== undefined && <>, Core {h.cotm}</>}
                    </span>
                  </p>
                  <ul class="powder" aria-label="Powder">
                    {(["mithril", "gemstone", "glacite"] as const).map(
                      (k) =>
                        h.powder[k] !== undefined && (
                          <li>
                            <Icon icon={powderIcon(k)} size={16} />
                            <span class="amount">{formatPowder(h.powder[k])}</span> {k[0]!.toUpperCase() + k.slice(1)}
                          </li>
                        ),
                    )}
                  </ul>
                  {h.note && <p class="muted small preset-note">{h.note}</p>}
                </div>
              ))}
              {trees.map((t) => (
                <div class="tree">
                  <h3>{t.data.title}</h3>
                  <p class="muted small">
                    Picture by {t.data.author && <Credit id={t.data.author.id} />}. {t.data.note}
                  </p>
                  <HotmTree id={t.id} label={`${t.data.title} HOTM tree`} perks={t.data.perks} ability={t.data.ability} disabled={t.data.disabled} />
                </div>
              ))}
              {trees.length === 0 && (
                <div class="tree-soon">
                  <span class="soon-grid" aria-hidden="true" />
                  <p><strong>Tree coming soon.</strong> <span class="muted">The drawn tree for this method is not confirmed yet.</span></p>
                </div>
              )}
              {hotmReqs.length > 0 && (
                <>
                  <h3>Key perks</h3>
                  <ul class="reqs">{hotmReqs.map((r) => <Requirement r={r} attributeNames={attributeNames} rarityOf={rarityOf} showTier />)}</ul>
                </>
              )}
            </section>
          )
        }

        <section id="gear" aria-labelledby="gear-title">
          <h2 id="gear-title">Gear</h2>
          <p class="muted">
            <span class="tier-key budget">Budget</span> is the cheapest setup the guide recommends and
            <span class="tier-key max">max</span> the best one. Items not marked apply to both.
          </p>
          {
            gear.map((s) => (
              <details class="gear-group" open>
                <summary>
                  <h3 id={`g-${s.id}`} class="with-icon">
                    <span class="slot"><Icon icon={groupIcon(s.id)} size={32} /></span>
                    {s.label}
                    <span class="count">{tierCount(s.budget.length + s.max.length + s.both.length)}</span>
                  </h3>
                </summary>
                {(s.budget.length > 0 || s.max.length > 0) && (
                  <div class="tiers">
                    <div class="tier">
                      <h4 class="tier-title budget">Budget setup</h4>
                      {s.budget.length ? (
                        <ul class="reqs">{s.budget.map((r) => <Requirement r={r} attributeNames={attributeNames} rarityOf={rarityOf} />)}</ul>
                      ) : (
                        <p class="muted small">Nothing extra for this tier.</p>
                      )}
                    </div>
                    <div class="tier">
                      <h4 class="tier-title max">Max setup</h4>
                      {s.max.length ? (
                        <ul class="reqs">{s.max.map((r) => <Requirement r={r} attributeNames={attributeNames} rarityOf={rarityOf} />)}</ul>
                      ) : (
                        <p class="muted small">Same as budget.</p>
                      )}
                    </div>
                  </div>
                )}
                {s.both.length > 0 && (
                  <>
                    {(s.budget.length > 0 || s.max.length > 0) && <h4 class="tier-title both">Both setups</h4>}
                    <ul class="reqs">{s.both.map((r) => <Requirement r={r} attributeNames={attributeNames} rarityOf={rarityOf} />)}</ul>
                  </>
                )}
              </details>
            ))
          }
        </section>
      </div>

      {
        attributeReqs.length > 0 && (
          <section id="attributes" aria-labelledby="attributes-title">
            <h2 id="attributes-title">Attributes</h2>
            <p class="muted">
              Level 10 values. See the <a href="/reference/attributes/">attribute reference</a> for every mining attribute.
            </p>
            <table class="table">
              <thead>
                <tr>
                  <th scope="col">Attribute</th>
                  <th scope="col">Shard</th>
                  <th scope="col">Effect</th>
                  <th scope="col">Priority</th>
                </tr>
              </thead>
              <tbody>
                {attributeReqs.map((r) => {
                  const a = r.kind === "attribute" ? attrById.get(r.attribute) : undefined;
                  return (
                    <tr data-requirement={r.id}>
                      <td data-label="Attribute" class="attr"><Icon icon={shardIcon(a?.rarity)} size={16} /><strong>{a?.name ?? (r.kind === "attribute" ? r.attribute : r.id)}</strong></td>
                      <td data-label="Shard">{a ? `${a.shard} (${a.rarity})` : "–"}</td>
                      <td data-label="Effect">{a?.effect}{r.note && <span class="muted"> {r.note}</span>}</td>
                      <td data-label="Priority">{r.priority ? PRIORITY[r.priority] : "–"}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </section>
        )
      }

      <div class="prose">
        <Content />
      </div>

      {
        g.videos.length > 0 && (
          <section id="videos" aria-labelledby="videos-title">
            <h2 id="videos-title">Videos</h2>
            <ul>
              {g.videos.map((v) => (
                <li>
                  <a href={v.url}>{v.title}</a>
                  {v.by && <span class="muted"> by {v.by}</span>}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section id="credits" aria-labelledby="credits-title">
        <h2 id="credits-title">Credits and sources</h2>
        <ul>
          {g.authors.map((a) => <li>{a.role ?? "Guide"}: <Credit id={a.id} all /></li>)}
          {g.contributors.map((a) => <li>{a.role ?? "Contributor"}: <Credit id={a.id} all /></li>)}
          <li>
            Source: {g.source.name}{g.source.posted && <>, posted {formatDate(g.source.posted)}</>}. Last checked {formatDate(g.updated)}.
          </li>
          <li>
            Requirements as data: <a href={`/guides/${guide.id}.json`}>{guide.id}.json</a> (format: <a href="/schema/guide.json">guide schema</a>).
          </li>
        </ul>
        <p class="muted small">Found a mistake? Tell the author in the Mining Cult Discord, or open an issue on <a href="https://github.com/tianiste/SkyProgression-WEB/issues">GitHub</a>.</p>
      </section>
    </article>

    <aside class="toc" aria-label="On this page">
      <p class="toc-title">On this page</p>
      <ul>{toc.map((t) => <li><a href={`#${t.id}`}><Icon icon={t.icon} size={16} />{t.label}</a></li>)}</ul>
    </aside>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }
  @media (min-width: 1000px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 13rem;
    }
    .toc {
      position: sticky;
      top: 1.5rem;
      align-self: start;
    }
  }
  @media (max-width: 999px) {
    .toc {
      display: none;
    }
  }
  .toc-title {
    font-weight: 650;
    margin-bottom: 0.5rem;
  }
  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--step--1);
    border-left: 2px solid var(--line);
  }
  .toc li a,
  .toc-mobile li a {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0 0.3rem 0.75rem;
    line-height: 1.35;
    color: var(--muted);
    text-decoration: none;
  }
  .toc li a:hover {
    color: var(--accent);
  }
  .toc-mobile {
    margin: 0 0 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .toc-mobile summary {
    padding: 0.7rem 1rem;
    font-weight: 650;
    cursor: pointer;
  }
  .toc-mobile ul {
    list-style: none;
    margin: 0;
    padding: 0 1rem 0.75rem 0.25rem;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
  }
  .toc-mobile li a {
    color: var(--text);
    text-decoration: none;
    padding-top: 0.45rem;
    padding-bottom: 0.45rem;
  }
  @media (min-width: 1000px) {
    .toc-mobile {
      display: none;
    }
  }
  /* Guide icon in a large slot beside the title; the summary runs under both on narrow screens. */
  .head-row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.5rem 1.25rem;
    align-items: center;
  }
  .head-row .slot {
    grid-row: span 2;
    align-self: start;
  }
  .title {
    margin: 0;
  }
  .head-row .lead {
    margin: 0;
  }
  @media (max-width: 560px) {
    .head-row .slot {
      grid-row: auto;
      padding: 4px;
    }
    .head-row .slot :global(.icon) {
      width: 32px;
      height: 32px;
    }
    .title {
      font-size: var(--step-3);
    }
    .head-row .lead {
      grid-column: 1 / -1;
      font-size: var(--step-0);
    }
  }
  .guide-head .seam,
  .seam {
    margin: 1.25rem 0 0;
  }
  section[id],
  .prose :global(h2),
  .gear-group h3 {
    scroll-margin-top: 1rem;
  }
  .with-icon {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .attr {
    display: flex;
    gap: 0.4rem;
    align-items: center;
  }
  @media (max-width: 640px) {
    .attr {
      display: block;
    }
  }
  .crumbs {
    font-size: var(--step--1);
    color: var(--muted);
    margin-bottom: 0.75rem;
  }
  .byline {
    font-size: var(--step--1);
    color: var(--muted);
    margin: 1rem 0 0;
    max-width: none;
  }
  .progress {
    display: grid;
    gap: 0.5rem;
    margin: 1.5rem 0 2rem;
    padding: 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .progress p {
    margin: 0;
    font-size: var(--step--1);
  }
  /* The XP bar from the logo: a deep green track that fills with bright green. */
  .xp {
    height: 12px;
    background: var(--surface-2);
    border: 2px solid var(--line);
  }
  .xp span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--xp);
    box-shadow: inset 0 -3px 0 var(--xp-deep);
  }
  /* Where and rates side by side, key blocks across the full width under them. */
  .glance {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: 0.75rem;
    margin: 0 0 1rem;
  }
  .glance > div {
    padding: 0.85rem 1rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .glance > .blocks {
    grid-column: 1 / -1;
    order: 2;
  }
  .glance dt {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 650;
    margin-bottom: 0.35rem;
  }
  .glance dd {
    margin: 0;
  }
  .glance ul {
    margin: 0;
    padding-left: 1.1rem;
  }
  .glance li + li {
    margin-top: 0.2rem;
  }
  .glance dd > p {
    margin: 0.4rem 0 0;
  }
  .rates {
    list-style: none;
  }
  .glance .rates {
    padding: 0;
  }
  .rate-label {
    display: block;
    color: var(--muted);
    font-size: var(--step--1);
  }
  .rate-value {
    font-weight: 650;
  }
  /* HOTM sits beside the gear on wide screens and above it on narrow ones. */
  .gear-hotm {
    display: grid;
    gap: 0 2.5rem;
  }
  @media (min-width: 1100px) {
    .gear-hotm {
      grid-template-columns: minmax(0, 1fr) 17.5rem;
    }
    .gear-hotm > #gear {
      grid-column: 1;
      grid-row: 1;
    }
    .gear-hotm > .hotm-col {
      grid-column: 2;
      grid-row: 1;
    }
    .hotm-col h2 {
      font-size: var(--step-2);
    }
  }
  .preset {
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
  }
  .preset-name {
    margin: 0 0 0.3rem;
  }
  .powder {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    font-size: var(--step--1);
  }
  .powder li {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .powder .amount {
    font-weight: 650;
  }
  .preset-note {
    margin: 0.3rem 0 0;
  }
  .tree h3 {
    font-size: var(--step-0);
    margin-bottom: 0.25rem;
  }
  .tree-soon {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    margin: 1rem 0;
    padding: 0.75rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    font-size: var(--step--1);
  }
  .tree-soon p {
    margin: 0;
  }
  .soon-grid {
    flex: none;
    width: 42px;
    height: 60px;
    background-image: radial-gradient(circle, var(--line) 2px, transparent 2.5px);
    background-size: 6px 6px;
    background-color: var(--slot-bg);
    border-radius: 2px;
  }
  .tiers {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 0 2rem;
  }

  .reqs {
    list-style: none;
    padding: 0;
    margin: 0 0 0.5rem;
  }
  .gear-group + .gear-group {
    border-top: 1px solid var(--line);
  }
  .gear-group summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    align-items: center;
  }
  .gear-group summary::-webkit-details-marker {
    display: none;
  }
  /* A pixel caret after the heading, pointing down when open. */
  .gear-group summary::after {
    content: "";
    margin-left: auto;
    width: 10px;
    height: 6px;
    background: var(--muted);
    clip-path: polygon(0 0, 100% 0, 100% 34%, 80% 34%, 80% 67%, 60% 67%, 60% 100%, 40% 100%, 40% 67%, 20% 67%, 20% 34%, 0 34%);
  }
  .gear-group:not([open]) summary::after {
    transform: rotate(-90deg);
  }
  .gear-group summary:hover h3 {
    color: var(--accent);
  }
  .gear-group h3 {
    margin: 1.25rem 0 0.75rem;
  }
  .gear-group:not([open]) h3 {
    margin-bottom: 1.25rem;
  }
  .count {
    font-family: var(--font-text);
    font-size: var(--step--1);
    font-weight: 400;
    color: var(--muted);
  }
  .tier-title {
    margin: 0.75rem 0 0.25rem;
    padding-left: 0.6rem;
    border-left: 4px solid var(--line);
    font-size: var(--step--1);
    color: var(--muted);
  }
  .tier-title.budget {
    border-color: var(--accent);
    color: var(--accent);
  }
  .tier-title.max {
    border-color: var(--gold);
    color: var(--gold);
  }
  .tier-key {
    font-weight: 650;
  }
  .tier-key.budget {
    color: var(--accent);
  }
  .tier-key.max {
    color: var(--gold);
  }
  .prose :global(ul) {
    padding-left: 1.25rem;
  }
</style>
