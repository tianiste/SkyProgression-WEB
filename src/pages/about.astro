---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Credit from "../components/Credit.astro";
import Icon from "../components/Icon.astro";
import { guideIcon, itemIcon } from "../lib/icons";
import { PEOPLE, type PersonId } from "../data/people";
import { SITE } from "../config";

const guides = (await getCollection("guides")).sort((a, b) => a.data.title.localeCompare(b.data.title));
const trees = (await getCollection("trees")).filter((t) => t.data.status === "published");
const hotfTrees = await getCollection("hotf");

const COMMUNITIES = new Set<PersonId>(["mining-cult", "foraging-community", "casters"]);

/** What each person made, collected from the guide and tree data. */
const credits = new Map<PersonId, string[]>();
const add = (id: PersonId, what: string) => credits.set(id, [...(credits.get(id) ?? []), what]);
for (const g of guides) {
  for (const a of g.data.authors) add(a.id, `${a.role ?? "Guide"}: ${g.data.title}`);
  for (const c of g.data.contributors) if (!COMMUNITIES.has(c.id)) add(c.id, `${c.role ?? "Contributor"}: ${g.data.title}`);
}
for (const t of trees) if (t.data.author) add(t.data.author.id, `HOTM tree: ${t.data.title}`);
for (const t of hotfTrees) add(t.data.author.id, `HotF tree: ${t.data.title}`);
for (const t of trees) if (t.data.collector) add(t.data.collector.id, "Heart of the Mountain tree guide (the HOTM tree numbers)");
const people = [...credits.entries()]
  .filter(([id]) => !COMMUNITIES.has(id))
  .sort(([a], [b]) => PEOPLE[a].name.localeCompare(PEOPLE[b].name));
---

<Base title="About" description="Who wrote the guides, where the data comes from, the license and privacy.">
  <h1>About</h1>
  <p class="lead">Community guides and the SkyProgression mod's numbers, for any player.</p>
  <div class="seam" aria-hidden="true"></div>

  <h2>Authors</h2>
  <p>
    Mining guides: <Credit id="mining-cult" />. Foraging: <Credit id="foraging-community" />. Fishing: <Credit id="casters" />.
    Published with the authors' permission; the content is theirs.
    {SITE.miningCultInvite && <> <a href={SITE.miningCultInvite}>Join the Mining Cult Discord</a> to ask the authors questions.</>}
  </p>
  <ul class="people">
    {
      people.map(([id, what]) => (
        <li>
          <Credit id={id} all />
          <span class="muted small">{[...new Set(what)].join("; ")}</span>
        </li>
      ))
    }
  </ul>
  <p>
    <a href="/reference/attributes/">Attributes</a> and <a href="/reference/stats/">stat sources</a>: unsigned Mining Cult
    guides; foraging and fishing attributes: Hypixel SkyBlock Wiki.
  </p>

  <h2>Data</h2>
  <p>
    Guide numbers are the authors' measurements, dated on each guide; check the date before spending coins. Each guide is
    also JSON (<a href="/schema/guide.json">schema</a>).
  </p>

  <h2 id="credits">Credits and licenses</h2>
  <p>
    Code: MIT, on <a href={SITE.webGithub}>GitHub</a>. Guide text: its authors. Logo, stat symbols and fallback icons: our
    own. The textures below are not MIT.
  </p>
  <dl class="sources">
    <div>
      <dt><span class="slot"><Icon icon={itemIcon("DIVAN_DRILL")} size={32} /></span>Item and armor textures</dt>
      <dd>
        <a href={SITE.furfsky}>FurfSky Reborn team</a>, with permission
        (<a href={SITE.furfskyModrinth}>pack</a> 1.9.2), including the 3D model's armor.
      </dd>
    </div>
    <div>
      <dt><span class="slot"><Icon icon={itemIcon("BAL")} size={32} /></span>Hypixel's own art</dt>
      <dd>
        The official
        <a href="https://hypixel.net/threads/hypixel-skyblock-0-26-skyblock-resource-pack-loadouts-security-quest-and-more.6117801/">Hypixel SkyBlock Resource Pack</a>
        and heads from Hypixel's API, © Hypixel Inc., under the pack's license. Heads drawn as in
        <a href="https://github.com/SkyCryptWebsite/SkyCrypt">SkyCrypt</a>, pet skins via its MIT pet table.
      </dd>
    </div>
    <div>
      <dt><span class="slot"><Icon icon={guideIcon("cobblestone")} size={32} /></span>Block textures</dt>
      <dd>
        Minecraft's own, © Mojang Studios, per Minecraft's usage guidelines.
      </dd>
    </div>
    <div>
      <dt><span class="slot"><Icon icon={{ kind: "glyph", glyph: "book", color: "var(--stat-purple)" }} size={32} /></span>Font</dt>
      <dd>Pixelify Sans, SIL Open Font License.</dd>
    </div>
  </dl>
  <p>Free fan project. Not an official Minecraft product; not endorsed by Hypixel, Mojang or Microsoft.</p>

  <h2>Privacy</h2>
  <p>
    No accounts, analytics or tracking cookies; the theme is saved in your browser. A lookup sends the name to the
    SkyProgression API, which reads the public profile from Hypixel and caches it for a few minutes.
  </p>
</Base>

<style>
  .people {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
  }
  .people li {
    padding: 0.55rem 0;
    border-top: 1px solid var(--line);
    display: grid;
  }
  .sources {
    max-width: var(--measure);
    margin: 0 0 1rem;
  }
  .sources > div {
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
  }
  .sources dt {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-weight: 650;
  }
  .sources dd {
    margin: 0.25rem 0 0 calc(40px + 0.85rem);
  }
  @media (max-width: 480px) {
    .sources dd {
      margin-left: 0;
    }
  }
</style>
