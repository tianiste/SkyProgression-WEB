---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import Credit from "../components/Credit.astro";
import Icon from "../components/Icon.astro";
import { guideIcon, itemIcon } from "../lib/icons";
import { PEOPLE, type PersonId } from "../data/people";
import { SITE } from "../config";

const guides = (await getCollection("guides")).sort((a, b) => a.data.title.localeCompare(b.data.title));
const trees = (await getCollection("trees")).filter((t) => t.data.status === "published");

/** What each person made, collected from the guide and tree data. */
const credits = new Map<PersonId, string[]>();
const add = (id: PersonId, what: string) => credits.set(id, [...(credits.get(id) ?? []), what]);
for (const g of guides) {
  for (const a of g.data.authors) add(a.id, `${a.role ?? "Guide"}: ${g.data.title}`);
  for (const c of g.data.contributors) if (c.id !== "mining-cult") add(c.id, `${c.role ?? "Contributor"}: ${g.data.title}`);
}
for (const t of trees) if (t.data.author) add(t.data.author.id, `HOTM tree: ${t.data.title}`);
const people = [...credits.entries()]
  .filter(([id]) => id !== "mining-cult")
  .sort(([a], [b]) => PEOPLE[a].name.localeCompare(PEOPLE[b].name));
---

<Base title="About" description="Who wrote the guides, where the data comes from, the license and privacy.">
  <h1>About</h1>
  <p class="lead">
    SkyProgression helps Hypixel SkyBlock players get better at mining. It started as a Fabric mod; this site begins
    with the community's mining guides and will grow into the mod's features for any player.
  </p>
  <div class="seam" aria-hidden="true"></div>

  <h2>The guides and their authors</h2>
  <p>
    Every guide was written by a miner from the <Credit id="mining-cult" /> and is published here with the author's
    permission. The content is theirs; this site only puts it in a form that a player lookup can check.
    {SITE.miningCultInvite && <> <a href={SITE.miningCultInvite}>Join the Mining Cult Discord</a> to ask the authors questions.</>}
  </p>
  <ul class="people">
    {
      people.map(([id, what]) => (
        <li>
          <Credit id={id} all />
          <span class="muted small">{[...new Set(what)].join("; ")}</span>
        </li>
      ))
    }
  </ul>
  <p>
    The <a href="/reference/attributes/">attribute</a> and <a href="/reference/stats/">stat source</a> references come from
    guides posted in the Mining Cult Discord without a named author.
  </p>

  <h2>Data and accuracy</h2>
  <p>
    Guide numbers are the authors' own measurements and estimates, dated on each guide. Game updates change them, so
    check the date before you spend coins. Requirements are stored with Hypixel item, pet, perk and attribute IDs so the
    mod's calculation engine can check them against a profile later. Each guide's data is available as JSON, in the
    format described by the <a href="/schema/guide.json">guide schema</a>.
  </p>

  <h2 id="credits">Credits and licenses</h2>
  <p>
    The site's code is under the MIT License; the source is on <a href={SITE.webGithub}>GitHub</a>. Guide text belongs to
    its authors. The SkyProgression logo, the stat symbols and the fallback icons are the project's own pixel art. None
    of the textures below are covered by the MIT License.
  </p>
  <dl class="sources">
    <div>
      <dt><span class="slot"><Icon icon={itemIcon("DIVAN_DRILL")} size={32} /></span>Item textures</dt>
      <dd>
        By the <a href={SITE.furfsky}>FurfSky Reborn team</a>, used with permission. From the
        <a href={SITE.furfskyModrinth}>FurfSky Reborn resource pack</a>, version 1.9.2.
      </dd>
    </div>
    <div>
      <dt><span class="slot"><Icon icon={itemIcon("BAL")} size={32} /></span>Hypixel's own art</dt>
      <dd>
        Items FurfSky Reborn does not retexture use textures from the official
        <a href="https://hypixel.net/threads/hypixel-skyblock-0-26-skyblock-resource-pack-loadouts-security-quest-and-more.6117801/">Hypixel SkyBlock Resource Pack</a>
        and item and pet heads from Hypixel's API. © Hypixel Inc., used under the pack's license. Heads are drawn as small
        cubes the way <a href="https://github.com/SkyCryptWebsite/SkyCrypt">SkyCrypt</a> draws them, with pet skins found
        through SkyCrypt's MIT-licensed pet table.
      </dd>
    </div>
    <div>
      <dt><span class="slot"><Icon icon={guideIcon("cobblestone")} size={32} /></span>Block textures</dt>
      <dd>
        Plain blocks and materials (Coal, Cobblestone, End Stone, Obsidian and similar) use Minecraft's own textures,
        © Mojang Studios, following Minecraft's usage guidelines.
      </dd>
    </div>
    <div>
      <dt><span class="slot"><Icon icon={{ kind: "glyph", glyph: "book", color: "var(--stat-purple)" }} size={32} /></span>Font</dt>
      <dd>Headings use Pixelify Sans under the SIL Open Font License.</dd>
    </div>
  </dl>
  <p>
    SkyProgression is a free fan project. It is not affiliated with or endorsed by Hypixel. It is not an official
    Minecraft product and is not approved by or associated with Mojang or Microsoft.
  </p>

  <h2>Privacy</h2>
  <p>
    The site has no accounts, no analytics and no tracking cookies. Your theme choice is saved in your browser only.
    Player lookup sends the name you enter and the guide's requirements to the SkyProgression API, which fetches that
    player's public SkyBlock profile from Hypixel and checks it; results are cached for a few minutes and not used for
    anything else. The name is kept in the page address so you can share the checked guide.
  </p>
</Base>

<style>
  .people {
    list-style: none;
    padding: 0;
    max-width: var(--measure);
  }
  .people li {
    padding: 0.55rem 0;
    border-top: 1px solid var(--line);
    display: grid;
  }
  .sources {
    max-width: var(--measure);
    margin: 0 0 1rem;
  }
  .sources > div {
    padding: 0.6rem 0;
    border-top: 1px solid var(--line);
  }
  .sources dt {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    font-weight: 650;
  }
  .sources dd {
    margin: 0.25rem 0 0 calc(40px + 0.85rem);
  }
  @media (max-width: 480px) {
    .sources dd {
      margin-left: 0;
    }
  }
</style>
