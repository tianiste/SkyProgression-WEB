---
import Base from "../layouts/Base.astro";
import MagicFindPlanner from "../components/islands/MagicFindPlanner";
import { iconTable } from "../magic-find/icons";
import "../styles/magic-find.css";
---

<Base title="Magic Find planner" description="Hypixel SkyBlock Magic Find upgrades after the 0.27.3 rework, cheapest point first, with live prices and payback time per mob.">
  <h1>Magic Find planner</h1>
  <p class="lead">Cheapest Magic Find first. Tick what you own, set a budget.</p>
  <div class="seam" aria-hidden="true"></div>
  <MagicFindPlanner client:only="preact" icons={iconTable()} />
  <noscript><p>The planner needs JavaScript.</p></noscript>
  <p class="muted small mf-foot">Drop chance × (1 + MF/100), on every drop. Cap 500. Values from the 0.27.3 release (17 Nov 2026).</p>
</Base>
