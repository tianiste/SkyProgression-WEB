---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import ReferenceNav from "../../components/ReferenceNav.astro";
import Credit from "../../components/Credit.astro";
import Icon from "../../components/Icon.astro";
import { shardIcon } from "../../lib/icons";

const all = await getCollection("attributes");
const FAMILIES = [
  { id: "stat", title: "Mining stats and powder", intro: "" },
  { id: "misc", title: "Mining loot, XP, events, pets", intro: "" },
  { id: "intelligence", title: "Mining Intelligence", intro: "For Maniac Miner's full Fortune bonus." },
  { id: "foraging", title: "Foraging", intro: "" },
  { id: "fishing", title: "Fishing", intro: "" },
] as const;
const RARITY = ["Common", "Uncommon", "Rare", "Epic", "Legendary"];
const SHARDS: Record<string, number> = { Common: 96, Uncommon: 64, Rare: 48, Epic: 32, Legendary: 24 };
const guides = await getCollection("guides");
const usedBy = (id: string) => guides.filter((g) => g.data.requirements.some((r) => r.kind === "attribute" && r.attribute === id));
---

<Base title="Attributes" description="Every mining, foraging and fishing attribute in Hypixel SkyBlock, its shard and its effect at level 10.">
  <ReferenceNav />
  <h1>Attributes</h1>
  <div class="seam" aria-hidden="true"></div>
  <p class="muted">
    Shards to level 10: {RARITY.map((r, i) => <>{i > 0 && ", "}{r} {SHARDS[r]}</>)}. Echo of Boxes + Echo of Echoes:
    Mossy Box and Gold Box +65 Fortune each.
  </p>

  {
    FAMILIES.map((f) => {
      const rows = all.filter((a) => a.data.family === f.id).sort((a, b) => RARITY.indexOf(a.data.rarity) - RARITY.indexOf(b.data.rarity));
      return (
        <section aria-labelledby={`fam-${f.id}`}>
          <h2 id={`fam-${f.id}`}>{f.title}</h2>
          {f.intro && <p class="muted">{f.intro}</p>}
          <table class="table">
            <thead>
              <tr>
                <th scope="col">Attribute</th>
                <th scope="col">Shard</th>
                <th scope="col">Effect at level 10</th>
                <th scope="col">Used in</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((a) => {
                const used = usedBy(a.id);
                return (
                  <tr id={a.id}>
                    <td data-label="Attribute"><span class="attr"><Icon icon={shardIcon(a.data.rarity)} size={16} /><strong>{a.data.name}</strong></span></td>
                    <td data-label="Shard">{a.data.shard} ({a.data.rarity})</td>
                    <td data-label="Effect">
                      {a.data.effect}
                      {a.data.note && <span class="muted"> {a.data.note}</span>}
                    </td>
                    <td data-label="Used in">
                      {used.length ? used.map((g, i) => <>{i > 0 && ", "}<a href={`/guides/${g.id}/${g.data.stages.length ? "#upgrades" : "#attributes"}`}>{g.data.title}</a></>) : <span class="muted">–</span>}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </section>
      );
    })
  }
  <p class="muted small">Mining: Mining Attribute Guide, <Credit id="mining-cult" />. Foraging, fishing: Hypixel SkyBlock Wiki.</p>
</Base>

<style>
  .attr {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
  }

</style>
